TELEGRAM_BOT_TOKEN=replace-with-a-new-token
# Recommended: comma-separated Telegram numeric user IDs. Empty allows anyone who knows the bot.
TELEGRAM_ALLOWED_USERS=
ARCHIVER_CATEGORIES=favorites,reference,projects,archive
ARCHIVER_DOWNLOAD_TIMEOUT=900
# Host path used by compose.yaml. Examples: ./data, /mnt/nas/media-base, D:/MediaBase
ARCHIVER_HOST_DATA=./data
# Set these to the owner of the host data folder (run `id` on Linux/NAS).
PUID=1000
PGID=1000
